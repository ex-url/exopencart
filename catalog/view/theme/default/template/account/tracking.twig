{{ header }}
<main id="account-tracking">
  <div class="container">
    <nav class="breadcrumb py-4" aria-label="breadcrumbs">
      <ul>
        {% for key, breadcrumb in breadcrumbs %}
        {% if key < (breadcrumbs|length - 1) %} <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% else %}
          <li><span>{{ breadcrumb.text }}</span></li>
          {% endif %}
          {% endfor %}
      </ul>
    </nav>
    <div class="columns is-multiline mb-5">{{ column_left }}
      {% if column_left and column_right %}
      {% set class = 'column is-6-fullhd is-6-widescreen is-6-desktop is-12-tablet is-12-mobile' %}
      {% elseif column_left or column_right %}
      {% set class = 'column is-9-fullhd is-9-widescreen is-9-desktop is-12-tablet is-12-mobile' %}
      {% else %}
      {% set class = 'column is-12' %}
      {% endif %}
      <div id="content" class="{{ class }}">{{ content_top }}
        <h1 class="title is-3">{{ heading_title }}</h1>
        <div class="content">
          <p>{{ text_description }}</p>
        </div>
        <div class="columns is-mobile is-multiline">
          <div id="link-column" class="column is-6-desktop is-6-tablet is-12-mobile">
            <div class="box">
              <div class="title is-6">
                {{ text_link }}
              </div>
              <div class="block is-clipped">
                <span class="icon-text is-flex-wrap-nowrap">
                  <span class="icon has-text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path
                        d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3" />
                    </svg>
                  </span>
                  <span id="reflink">{{ host }}{{ code }}</span>
                </span>
              </div>
              <div class="block">
                <span id="copy-trigger" class="button is-primary is-light"
                  onclick="copyToClipboard('#reflink', function(){notification({type: 'success', text: '{{ text_copied }}'})})">
                  <span class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path
                        d="M13 0H6a2 2 0 0 0-2 2 2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2 2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 13V4a2 2 0 0 0-2-2H5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1zM3 4a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4z" />
                    </svg>
                  </span>
                  <span>{{ text_copy }}</span>
                </span>
              </div>
            </div>
          </div>
          <div class="column is-6-desktop is-6-tablet is-12-mobile">
            <div class="box">
              <div class="is-flex">
                <div class="p-1" style="background-color: white;">
                  <div id="qrcode" style="width: 122px; height: 122px; overflow: hidden;"></div>
                </div>
                <div class="ml-4">
                  <div class="title is-6">
                    {{ text_qr_code }}
                  </div>
                  <div class="buttons">
                    <button id="save-qrcode" class="button is-primary is-light" onclick="downloadQRCode()">{{
                      button_download }}</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="column is-12">
            <div class="box">
              <div class="title is-6">
                {{ text_generator }}
              </div>
              <div class="control">
                <input type="text" class="input" id="generator" placeholder="{{ entry_link }}">
              </div>
              <div class="buttons mb-0 mt-3">
                <button class="button is-primary mb-0" onclick="generate()">{{ button_generate }}</button>
              </div>
            </div>
          </div>
        </div>
        <div class="buttons">
          <a href="{{ continue }}" class="button is-primary is-light">
            <span class="icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd"
                  d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
              </svg>
            </span>
            <span>{{ button_back }}</span>
          </a>
        </div>
        {{ content_bottom }}
      </div>
      {{ column_right }}
    </div>
  </div>
</main>
<script>
  $(document).ready(function () {

    const qrContainer = document.getElementById("qrcode");

    createQRCode(qrContainer, '{{host}}{{code}}');

  });

  function createQRCode(container, link) {

    $(container).empty();

    const qrcode = new QRCode(container, {
      text: link,
      width: 1024,
      height: 1024,
      colorDark: "#000000",
      colorLight: "#ffffff",
      correctLevel: QRCode.CorrectLevel.H
    });
  }

  function downloadQRCode() {
    const img = document.querySelector('#qrcode img');

    fetch(img.src)
      .then(res => res.blob())
      .then(blob => {
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = 'qrcode.png';
        link.href = url;
        link.click();
        URL.revokeObjectURL(url);
      });
  }

  function generate() {
    const link = $('#generator').val() + '{{ code }}';

    if (link.startsWith(window.location.origin)) {
      $('#reflink').text(link);

      const qrContainer = document.getElementById("qrcode");
      createQRCode(qrContainer, link);

      document.getElementById("link-column").scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });

      $('#copy-trigger').click();

      $('#generator').val('')

    } else {
      $('#generator').after('<p class="help is-danger">' + '{{ error_link }}' + '</p>');
      setTimeout(function () {
        $('#generator').next().remove();
      }, 3000)
    }
  }
</script>
{{ footer }}