{{ header }}
<main id="account-account">
  <div class="container">
    <nav class="breadcrumb py-4" aria-label="breadcrumbs">
      <ul>
        {% for key, breadcrumb in breadcrumbs %}
        {% if key < (breadcrumbs|length - 1) %} <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% else %}
          <li><span>{{ breadcrumb.text }}</span></li>
          {% endif %}
          {% endfor %}
      </ul>
    </nav>
    <div class="columns is-multiline">
      {{ column_left }}
      {% if column_left and column_right %}
      {% set class = 'column is-6-fullhd is-6-widescreen is-6-desktop is-12-tablet is-12-mobile' %}
      {% elseif column_left or column_right %}
      {% set class = 'column is-9-fullhd is-9-widescreen is-9-desktop is-12-tablet is-12-mobile' %}
      {% else %}
      {% set class = 'column is-12' %}
      {% endif %}
      <div id="content" class="{{ class }} mb-5">
        {{ content_top }}
        <h1 class="title is-3">{{ text_account }}</h1>
        {% if incomplete %}
        <div class="notification is-danger is-light pr-5">
          <div class="is-flex is-flex-wrap-wrap is-align-items-center is-justify-content-space-between">
            <div>{{ error_incomplete }}</div>
            <a href="{{edit}}" class="button is-danger is-small">{{ button_edit }}</a>
          </div>
        </div>
        {% endif %}
        <div class="block">
          {% if orders %}
          <div class="title is-5">
            {{ text_latest_order }}
          </div>
          {% for key, order in orders %}
          {% if key < 3 %} <div class="box mb-3 p-3">
            <div class="columns is-mobile is-multiline is-align-items-center">
              <div class="column is-2-desktop is-3-tablet is-3-mobile">
                <p class="is-size-7 has-text-grey">{{ column_order_id }}</p>
                <div class="has-text-weight-bold">
                  {{ order.order_id }}
                </div>
              </div>
              <div class="column is-2-desktop is-6-tablet is-9-mobile has-text-right">
                <p class="is-size-7 has-text-grey">{{ column_date_added }}</p>
                <div class="block">
                  <b>{{ order.date_added }}</b>
                </div>
              </div>
              <div class="column is-2-desktop is-3-tablet is-6-mobile">
                <p class="is-size-7 has-text-grey">{{ column_status }}</p>
                <div class="block">
                  <span class="tag is-primary is-light">{{ order.status }}</span>
                </div>
              </div>
              <div class="column is-2-desktop is-4-tablet is-6-mobile has-text-right">
                <p class="is-size-7 has-text-grey">{{ column_total }}</p>
                <div class="has-text-weight-bold">
                  {{ order.total }}
                </div>
              </div>
              <div class="column is-4-desktop is-4-tablet is-12-mobile">
                <div class="block has-text-right">
                  <a href="{{ order.view }}" class="button is-primary is-light is-fullwidth">
                    <span class="icon">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16"
                        stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" height="24" width="24">
                        <path
                          d="M4.6875 10.024375000000001 2.9299999999999997 12.1875 1.875 11.46625m2.8125 -5.048125 -1.7574999999999998 2.1637500000000003L1.875 7.860625M4.6875 2.8125 2.9299999999999997 4.97625 1.875 4.255M6.875 10.9375h6.25M6.875 7.5h6.25M6.875 4.0625h6.25"
                          stroke-width="1"></path>
                      </svg>
                    </span>
                    <span>{{ text_history }}</span>
                  </a>
                </div>
              </div>
            </div>
        </div>
        {% endif %}
        {% endfor %}
        {% endif %}
      </div>
      <hr>
      {% if tracking %}
      <div class="title is-5">
        {{ text_affiliate }}
      </div>
      <div class="columns is-mobile is-multiline">
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="mb-2 has-text-grey">{{ text_clicks }}</div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path
                    d="M4.325 4.3475 3.40625 3.420625m5.818124999999999 0.9268750000000001 0.91875 -0.9268750000000001m-6.7375 6.800000000000001 0.91875 -0.9275m2.45 -6.18125V1.875m-3.675 4.945625H1.875m8.671875 3.7018750000000002 2.38375 -0.94125a0.31 0.31 0 0 0 0 -0.575625l-5.7281249999999995 -2.2593750000000004a0.3075 0.3075 0 0 0 -0.396875 0.4l2.23875 5.781874999999999c0.10125 0.2625 0.46875 0.2625 0.5700000000000001 0z"
                    stroke-width="1"></path>
                </svg>
              </span>
              <span class="is-size-4 has-text-weight-bold has-text-black">{{ affiliate.clicks }}</span>
            </div>
          </div>
        </div>
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <span class="has-text-grey">{{ text_orders }}</span>
              <span class="tag is-primary is-light">{{ text_conversion }}: {{ conversion_rate }}%</span>
            </div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path
                    d="m6.875 6.401250000000001 0.64625 0.738125c0.059375 0.068125 0.16625 0.0625 0.21875 -0.01l1.3125 -1.816875M10.3125 13.125a0.9375 0.9375 0 1 0 0 -1.875 0.9375 0.9375 0 0 0 0 1.875m-5 0a0.9375 0.9375 0 1 0 0 -1.875 0.9375 0.9375 0 0 0 0 1.875"
                    stroke-width="1"></path>
                  <path
                    d="M2.31875 3.375h9.508750000000001c0.86125 0 1.4831250000000002 0.79375 1.2468750000000002 1.5925l-1.03375 3.5C11.881250000000001 9.004999999999999 11.3725 9.375 10.79375 9.375H5.07c-0.579375 0 -1.08875 -0.370625 -1.2475 -0.9075zm0 0L1.875 1.875"
                    stroke-width="1"></path>
                </svg>
              </span>
              <span class="is-size-4 has-text-weight-bold has-text-black">{{ affiliate_sales }}</span>
            </div>
          </div>
        </div>
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <span class="has-text-grey">{{ text_balance }}</span>
              <a href="{{ transaction }}" class="tag is-primary is-light">{{ text_transactions }}</a>
            </div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path
                    d="M1.875 5.625v-0.5c0 -0.7000000000000001 0 -1.05 0.13625 -1.3175000000000001 0.12 -0.235625 0.310625 -0.42625 0.54625 -0.54625C2.8249999999999997 3.125 3.175 3.125 3.875 3.125h7.25c0.7000000000000001 0 1.05 0 1.316875 0.13625 0.235625 0.12 0.426875 0.310625 0.546875 0.54625 0.13625 0.266875 0.13625 0.616875 0.13625 1.315625V5.625M1.875 5.625h11.25M1.875 5.625v4.25c0 0.7000000000000001 0 1.05 0.13625 1.3175000000000001a1.25 1.25 0 0 0 0.54625 0.54625c0.266875 0.13625 0.616875 0.13625 1.315625 0.13625h7.25375c0.6987500000000001 0 1.048125 0 1.315 -0.13625 0.235625 -0.12 0.426875 -0.31125 0.546875 -0.54625 0.13625 -0.2675 0.13625 -0.61625 0.13625 -1.315V5.625M3.75 9.375h2.5"
                    stroke-width="1"></path>
                </svg>
              </span>
              <span class="is-size-4 has-text-weight-bold has-text-black">{{ balance }}</span>
            </div>
          </div>
        </div>
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="mb-2 has-text-grey">{{ text_commission }}</div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path
                    d="M11.875 3.125 3.125 11.875m7.8125 0.625c1.041875 0 1.5625 -0.535625 1.5625 -1.875s-0.520625 -1.875 -1.5625 -1.875 -1.5625 0.535625 -1.5625 1.875 0.520625 1.875 1.5625 1.875m-6.875 -6.25C5.104375 6.25 5.625 5.714375 5.625 4.375s-0.520625 -1.875 -1.5625 -1.875S2.5 3.035625 2.5 4.375s0.520625 1.875 1.5625 1.875"
                    stroke-width="1"></path>
                </svg>
              </span>
              <span class="is-size-4 has-text-weight-bold has-text-black">{{ affiliate.commission }}%</span>
            </div>
          </div>
        </div>
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="mb-2 has-text-grey">{{ text_links }}</div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path
                    d="m9.9925 8.125 2.43875 -2.43875c0.8981250000000001 -0.8981250000000001 0.9281250000000001 -2.32375 0.066875 -3.1843749999999997 -0.860625 -0.86125 -2.28625 -0.83125 -3.1843749999999997 0.066875L6.875 5.0075m1.25 4.96875 -2.4325 2.425c-0.895 0.8937499999999999 -2.275 1.009375 -3.17625 0.066875 -0.90125 -0.9418749999999999 -0.8287500000000001 -2.274375 0.066875 -3.1674999999999995L5.015625 6.875M5.625 9.375l3.75 -3.75"
                    stroke-width="1"></path>
                </svg>
              </span>
              <a href="{{ tracking }}" class="button is-primary is-light">{{ button_get_link }}</a>
            </div>
          </div>
        </div>
        <div class="column is-4-desktop is-6-tablet is-12-mobile">
          <div class="box">
            <div class="mb-2 has-text-grey">{{ text_partner_details }}</div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <span class="icon is-large has-text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
                  stroke-linejoin="round" stroke="currentColor" height="100" width="100">
                  <path d="M7.5 10v-3.125h-0.3125m0 3.125h0.625M7.5 5.3125V5" stroke-width="1"></path>
                  <path
                    d="M1.875 5.875c0 -1.4000000000000001 0 -2.1 0.2725 -2.6350000000000002a2.5 2.5 0 0 1 1.0925 -1.0925C3.775 1.875 4.475 1.875 5.875 1.875h3.25c1.4000000000000001 0 2.1 0 2.6350000000000002 0.2725a2.5 2.5 0 0 1 1.0925 1.0925C13.125 3.775 13.125 4.475 13.125 5.875v3.25c0 1.4000000000000001 0 2.1 -0.2725 2.6350000000000002a2.5 2.5 0 0 1 -1.0925 1.0925C11.225000000000001 13.125 10.525 13.125 9.125 13.125H5.875c-1.4000000000000001 0 -2.1 0 -2.6350000000000002 -0.2725a2.5 2.5 0 0 1 -1.0925 -1.0925C1.875 11.225000000000001 1.875 10.525 1.875 9.125z"
                    stroke-width="1"></path>
                </svg>
              </span>
              <a href="{{ affiliate_action }}" class="button is-primary is-light">{{ button_edit }}</a>
            </div>
          </div>
        </div>
      </div>
      {% else %}
      <a class="button is-success" href="{{ affiliate_action }}">
        <span class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round"
            stroke-linejoin="round" stroke="currentColor" height="20" width="20">
            <path
              d="M5.9375 7.5a1.5625 1.5625 0 1 1 -3.125 0 1.5625 1.5625 0 0 1 3.125 0m3.125 -3.4375 -3.125 2.1875m3.125 4.6875 -3.125 -2.1875m6.25 2.8125a1.5625 1.5625 0 1 1 -3.125 0 1.5625 1.5625 0 0 1 3.125 0m0 -8.125a1.5625 1.5625 0 1 1 -3.125 0 1.5625 1.5625 0 0 1 3.125 0"
              stroke-width="1"></path>
          </svg>
        </span>
        <span>{{ text_become_partner }}</span>
      </a>
      {% endif %}
    </div>
    {{ column_right }}
  </div>
  </div>
  {{ content_bottom }}
</main>
{{ footer }}