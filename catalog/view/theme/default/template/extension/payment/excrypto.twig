<div class="excrypto-payment">
	<div class="title is-5 mb-5">
    {{ text_title }}
  </div>	
	{% if invoice_url %}
	<div class="notification is-info is-light">{{ text_before_pay }}</div>
	<div class="mt-3">
	  <a href="{{ invoice_url }}" class="button is-primary is-medium is-fullwidth">{{ button_pay }}</a>
	</div>
	{% else %}
	<div class="notification is-danger is-light">
	  {{ error }}
	</div>
	{% endif %}	
</div>