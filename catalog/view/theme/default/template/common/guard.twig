<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ heading_title }}</title>
    <link rel="stylesheet" href="{{ style }}">
    <link rel="icon" href="{{ favicon }}" />
    <script src="catalog/view/theme/default/js/jquery.min.js"></script>
  </head>
</html>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; height: 100vh;">
  <main id="guard-page" style="height:100%;" class="is-flex is-flex-direction-column is-justify-content-center is-align-items-center has-text-centered">
    {% if captcha %}
    <form action="{{ action }}" method="post" class="box mx-auto" style="width: 100%;max-width: 420px;">
      <span class="icon is-large has-text-success">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" height="100" width="100">
          <path d="m6.411249999999999 7.026250000000001 0.64625 0.738125c0.059375 0.068125 0.16625 0.0625 0.21875 -0.01l1.3125 -1.816875" stroke-width="1"></path>
          <path d="M7.166875 13.0125a0.55 0.55 0 0 0 0.66625 0C8.855 12.245625 11.875 9.74125 11.875 6.885v-3.08125a0.32125000000000004 0.32125000000000004 0 0 0 -0.285625 -0.321875 7.53 7.53 0 0 1 -3.48875 -1.2787499999999998l-0.38125 -0.260625a0.3875 0.3875 0 0 0 -0.43875 0l-0.38125 0.260625a7.53 7.53 0 0 1 -3.48875 1.2787499999999998 0.32125000000000004 0.32125000000000004 0 0 0 -0.285625 0.321875v3.08125c0 2.85625 3.02 5.360625 4.041875 6.12625" stroke-width="1"></path>
        </svg>
      </span>
      <h1 class="title is-4 my-5">{{ heading_title }}</h1>
      {% if error_captcha %}
      <div class="notification is-danger is-light">{{ error_captcha }}</div>
      {% endif %}
      {{ captcha }}
      <div class="control">
        <button type="submit" class="button is-primary is-medium is-fullwidth">{{ button_continue }}</button>
      </div>
    </form>
    {% else %}
    <div class="box mx-auto" style="width: 100%;max-width: 420px;">
      <div class="mb-3">
        <span class="icon is-large has-text-danger">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="-0.5 -0.5 16 16" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" height="100" width="100">
            <path d="M7.5 5.3125V8.75m0 2.029375v-0.3125m-3.7624999999999997 -3.740625C5.380000000000001 3.491875 6.2 1.875 7.5 1.875c1.3 0 2.120625 1.616875 3.7624999999999997 4.851249999999999l0.204375 0.4025c1.36375 2.6875 2.04625 4.03125 1.4293749999999998 5.01375C12.28 13.125 10.754999999999999 13.125 7.704375 13.125h-0.40875c-3.05 0 -4.575625 0 -5.1918750000000005 -0.9825 -0.616875 -0.9825 0.065625 -2.32625 1.4293749999999998 -5.01375z" stroke-width="1"></path>
          </svg>
        </span>
      </div>
      <div>{{ text_captcha_disabled }}</div>
    </div>
    {% endif %}
  </main>
</body>
