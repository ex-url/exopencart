{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" name="apply" value="1" data-toggle="tooltip" title="{{ button_apply }}" class="btn btn-success"><i class="fa fa-repeat"></i></button>
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-params" data-toggle="tab">{{ tab_params }}</a></li>
            <li><a href="#tab-yandex" data-toggle="tab">{{ tab_yandex }}</a></li>
            <li><a href="#tab-vk" data-toggle="tab">{{ tab_vk }}</a></li>
            <li><a href="#tab-google" data-toggle="tab">{{ tab_google }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-params">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="module_auth_status" id="input-status" class="form-control">
                    {% if module_auth_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="" class="col-sm-2 control-label">{{ entry_collect }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[collect]" value="1" {{ module_auth_settings.collect ? 'checked' : '' }}>
                    {{ text_yes }}
                  </label>
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[collect]" value="0" {{ not module_auth_settings.collect ? 'checked' : '' }}>
                    {{ text_no }}
                  </label>
                  <div>
                    <small class="text-info">{{ help_collect }}</small>
                  </div>                  
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-yandex">
              <div class="form-group">
                <label for="" class="col-sm-2 control-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[yandex_status]" value="1" {{ module_auth_settings.yandex_status ? 'checked' : '' }}>
                    {{ text_enabled }}
                  </label>
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[yandex_status]" value="0" {{ not module_auth_settings.yandex_status ? 'checked' : '' }}>
                    {{ text_disabled }}
                  </label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-yandex-client-id">{{ entry_client_id }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input 
                      type="password" 
                      name="module_auth_settings[yandex_client_id]"
                      value="{{ module_auth_settings.yandex_client_id }}" 
                      placeholder="{{ entry_client_id }}"
                      id="input-yandex-client-id"
                      class="form-control"
                    />
                    <span class="input-group-btn">
                      <button type="button" class="toggle-password btn btn-default" onclick="togglePasswordVisibility('input-yandex-client-id')"><i class="fa fa-eye"></i></button>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-vk">
              <div class="form-group">
                <label for="" class="col-sm-2 control-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[vk_status]" value="1" {{ module_auth_settings.vk_status ? 'checked' : '' }}>
                    {{ text_enabled }}
                  </label>
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[vk_status]" value="0" {{ not module_auth_settings.vk_status ? 'checked' : '' }}>
                    {{ text_disabled }}
                  </label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-vk-application_id">{{ entry_vk_application_id }}</label>
                <div class="col-sm-10">
                  <input 
                    type="text" 
                    name="module_auth_settings[vk_application_id]"
                    value="{{ module_auth_settings.vk_application_id }}" 
                    placeholder="{{ entry_vk_application_id }}"
                    id="input-vk-application_id" class="form-control" 
                  />
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-google">
              <div class="form-group">
                <label for="" class="col-sm-2 control-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[google_status]" value="1" {{ module_auth_settings.google_status ? 'checked' : '' }}>
                    {{ text_enabled }}
                  </label>
                  <label class="radio-inline">
                    <input type="radio" name="module_auth_settings[google_status]" value="0" {{ not module_auth_settings.google_status ? 'checked' : '' }}>
                    {{ text_disabled }}
                  </label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-google-client-id">{{ entry_client_id }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input 
                      type="password" 
                      name="module_auth_settings[google_client_id]"
                      value="{{ module_auth_settings.google_client_id }}" 
                      placeholder="{{ entry_client_id }}"
                      id="input-google-client-id"
                      class="form-control"
                    />
                    <span class="input-group-btn">
                      <button type="button" class="toggle-password btn btn-default" onclick="togglePasswordVisibility('input-google-client-id')"><i class="fa fa-eye"></i></button>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>          
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
